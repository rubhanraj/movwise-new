# Frontend Environment Variables
VITE_API_URL=http://localhost:3001

# CAPTCHA Configuration (Optional)
# Set to 'true' to enable CAPTCHA, requires site key
VITE_CAPTCHA_ENABLED=false
VITE_CAPTCHA_PROVIDER=hcaptcha
# Get your site key from https://www.hcaptcha.com/ or https://www.google.com/recaptcha/admin
VITE_CAPTCHA_SITE_KEY=

